{
  "name": "project-manager",
  "version": "1.1.0",
  "description": "A keyboard-first desktop hub for your local projects: open them in your editor, see git status, track tasks.",
  "license": "MIT",
  "author": "Yiğit Enes Kaya",
  "homepage": "https://github.com/vdnp/proje-yoneticisi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vdnp/proje-yoneticisi.git"
  },
  "bugs": {
    "url": "https://github.com/vdnp/proje-yoneticisi/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "dev:web": "vite --config vite.web.config.js",
    "build:web": "vite build --config vite.web.config.js",
    "gen:icons": "node scripts/gen-icons.mjs",
    "screenshots": "electron scripts/screenshots.cjs",
    "build": "electron-vite build && electron-builder --win",
    "build:dir": "electron-vite build && electron-builder --win --dir",
    "release:patch": "npm version patch --no-git-tag-version && npm run build",
    "release:minor": "npm version minor --no-git-tag-version && npm run build",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dompurify": "^3.4.16",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "marked": "^18.0.14",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "com.eneskaya.projectmanager",
    "productName": "Proje Yöneticisi",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "proje-yoneticisi-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Proje Yöneticisi",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
